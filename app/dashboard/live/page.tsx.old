'use client';

import React, { useEffect, useMemo, useRef, useState } from 'react';
import {
  Play,
  Pause,
  RotateCcw,
  Users,
  Clock,
  CheckCircle2,
  AlertTriangle,
  ClipboardList,
  MessageSquare,
  Mic,
  MicOff,
  Sparkles,
  Link2,
  Plus,
  Send,
} from 'lucide-react';

interface TranscriptEntry {
  id: string;
  speaker: string;
  text: string;
  timestamp: string;
}

interface InsightItem {
  id: string;
  title: string;
  detail: string;
  assignee?: string;
  dueDate?: string;
}

interface LiveInsights {
  summary: string;
  decisions: InsightItem[];
  actionItems: InsightItem[];
  risks: InsightItem[];
}

interface SpeechRecognitionEvent extends Event {
  results: ArrayLike<ArrayLike<{ transcript: string }>>;
}

declare global {
  interface Window {
    webkitSpeechRecognition?: any;
    SpeechRecognition?: any;
  }
}

export default function LiveMeetingPage() {
  const [isPlaying, setIsPlaying] = useState(true);
  const [timer, setTimer] = useState(0);
  const [isListening, setIsListening] = useState(false);
  const [entries, setEntries] = useState<TranscriptEntry[]>([]);
  const [insights, setInsights] = useState<LiveInsights>({
    summary: 'Waiting for the meeting to begin.',
    decisions: [],
    actionItems: [],
    risks: [],
  });
  const [statusMessage, setStatusMessage] = useState('The live assistant is ready. Click start listening to capture the meeting.');
  const [recognition, setRecognition] = useState<any>(null);
  const [meetingId, setMeetingId] = useState<string | null>(null);
  const [title, setTitle] = useState('Live AI Meeting');
  const [hostName, setHostName] = useState('Host');
  const [joinLink, setJoinLink] = useState('/dashboard/live');
  const [participants, setParticipants] = useState<string[]>(['Host']);
  const [memory, setMemory] = useState<string[]>([]);
  const [activity, setActivity] = useState<Array<{ id: string; text: string; timestamp: string }>>([]);
  const [draftNote, setDraftNote] = useState('');
  const [isCreating, setIsCreating] = useState(false);
  const [isJoining, setIsJoining] = useState(false);
  const [meetingStatus, setMeetingStatus] = useState<'scheduled' | 'live' | 'ended'>('scheduled');
  const meetingIdRef = useRef<string | null>(null);

  useEffect(() => {
    if (!isPlaying) return;
    const interval = window.setInterval(() => setTimer((prev) => prev + 1), 1000);
    return () => window.clearInterval(interval);
  }, [isPlaying]);

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('meetingId');
    if (id) {
      setMeetingId(id);
      setIsJoining(true);
      fetch(`/api/live-meetings/${id}`)
        .then((res) => res.json())
        .then((data) => {
          setEntries(data.transcriptEntries || []);
          setInsights(data.insights || {
            summary: 'Live meeting summary is being generated.',
            decisions: [],
            actionItems: [],
            risks: [],
          });
          setParticipants(data.participants || ['Host']);
          setMemory(data.memory || []);
          setActivity(data.aiActivity || []);
          setMeetingStatus(data.status || 'scheduled');
          setTitle(data.title || 'Live AI Meeting');
          setHostName(data.hostName || 'Host');
          setJoinLink(data.joinLink || `/dashboard/live?meetingId=${id}`);
          setStatusMessage(`Joined meeting ${data.title || 'Live AI Meeting'}.`);
        })
        .catch(() => setStatusMessage('Unable to load the selected meeting session.'))
        .finally(() => setIsJoining(false));
    }
  }, []);

  useEffect(() => {
    meetingIdRef.current = meetingId;
  }, [meetingId]);

  useEffect(() => {
    if (typeof window === 'undefined') return;
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
      setStatusMessage('Speech recognition is not supported in this browser. Use Chrome or Edge for live transcription.');
      return;
    }

    const instance = new SpeechRecognition();
    instance.continuous = true;
    instance.interimResults = true;
    instance.lang = 'en-US';

    instance.onstart = () => {
      setIsListening(true);
      setStatusMessage('Listening to the meeting and extracting insights...');
    };

    instance.onerror = (event: any) => {
      // 'no-speech' fires whenever a silence window elapses — it's non-fatal and recognition
      // will fire onend and restart automatically via the handler below.
      if (event.error === 'no-speech' || event.error === 'audio-capture' || event.error === 'aborted') {
        console.warn('[Live] Non-fatal recognition event:', event.error, '— will auto-resume.');
        return;
      }
      console.error('Speech recognition error', event.error);
      setStatusMessage(`Listening stopped: ${event.error}`);
      setIsListening(false);
    };

    instance.onend = () => {
      // If we are still in listening state, restart immediately to maintain a continuous loop
      setIsListening((currentlyListening) => {
        if (currentlyListening) {
          try { instance.start(); } catch (_) { /* already started */ }
          return true;
        }
        setStatusMessage('Listening paused. Click resume to continue.');
        return false;
      });
    };

    instance.onresult = async (event: SpeechRecognitionEvent) => {
      const finalText = Array.from(event.results)
        .map((result) => result[0]?.transcript || '')
        .join(' ')
        .trim();

      if (!finalText) return;

      const entry: TranscriptEntry = {
        id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
        speaker: 'Participant',
        text: finalText,
        timestamp: new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }),
      };

      setEntries((prev) => [...prev, entry]);
      setStatusMessage('Transcript updated. The assistant is analyzing it live.');

      const activeMeetingId = meetingIdRef.current;
      if (!activeMeetingId) {
        setStatusMessage('Create or join a meeting before speaking.');
        return;
      }

      try {
        const response = await fetch(`/api/live-meetings/${activeMeetingId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: finalText, speaker: entry.speaker }),
        });

        if (!response.ok) throw new Error('Live insight update failed');
        const data = await response.json();
        setInsights(data.insights || {
          summary: 'Live meeting summary is being generated.',
          decisions: [],
          actionItems: [],
          risks: [],
        });
        setParticipants(data.participants || ['Host']);
        setMemory(data.memory || []);
        setActivity(data.aiActivity || []);
        setMeetingStatus(data.status || 'live');
      } catch (error) {
        console.error(error);
      }
    };

    instance.start();
    setRecognition(instance);
    setIsListening(true);

    return () => instance.stop();
  }, []);

  const handleReset = () => {
    setEntries([]);
    setTimer(0);
    setIsPlaying(true);
    setInsights({ summary: 'Meeting reset. Waiting for a new live session.', decisions: [], actionItems: [], risks: [] });
    setStatusMessage('Meeting reset. Start listening again.');
  };

  const createMeeting = async () => {
    setIsCreating(true);
    try {
      const response = await fetch('/api/live-meetings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, hostName }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to create meeting');
      const nextId = data.meeting?.id;
      setMeetingId(nextId);
      setJoinLink(data.meeting?.joinLink || `/dashboard/live?meetingId=${nextId}`);
      setParticipants(data.meeting?.participants || [hostName]);
      setMemory(data.meeting?.memory || []);
      setActivity(data.meeting?.aiActivity || []);
      setEntries(data.meeting?.transcriptEntries || []);
      setInsights(data.meeting?.insights || { summary: 'Meeting created. Ready to begin.', decisions: [], actionItems: [], risks: [] });
      setMeetingStatus(data.meeting?.status || 'scheduled');
      setStatusMessage(`Meeting created. Share ${window.location.origin}${data.meeting?.joinLink || ''}`);
      const nextUrl = `${window.location.pathname}?meetingId=${nextId}`;
      window.history.replaceState({}, '', nextUrl);
    } catch (error) {
      console.error(error);
      setStatusMessage('Unable to create a meeting right now.');
    } finally {
      setIsCreating(false);
    }
  };

  const startMeeting = async () => {
    if (!meetingId) return;
    try {
      const response = await fetch(`/api/live-meetings/${meetingId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'start' }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to start meeting');
      setMeetingStatus(data.meeting?.status || 'live');
      setStatusMessage('Meeting is now live.');
    } catch (error) {
      console.error(error);
      setStatusMessage('Unable to start the meeting.');
    }
  };

  const endMeeting = async () => {
    if (!meetingId) return;
    try {
      const response = await fetch(`/api/live-meetings/${meetingId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'end' }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to end meeting');
      setMeetingStatus(data.meeting?.status || 'ended');
      setStatusMessage('Meeting ended and summaries are archived.');
    } catch (error) {
      console.error(error);
      setStatusMessage('Unable to end the meeting.');
    }
  };

  const handleAddMemory = async () => {
    if (!meetingId || !draftNote.trim()) return;
    try {
      const response = await fetch(`/api/live-meetings/${meetingId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'memory', note: draftNote }),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Unable to save memory note');
      setMemory(data.meeting?.memory || []);
      setDraftNote('');
      setStatusMessage('Organizational memory updated.');
    } catch (error) {
      console.error(error);
      setStatusMessage('Unable to save the memory note.');
    }
  };

  const handleToggleListening = () => {
    if (!recognition) return;
    if (isListening) {
      recognition.stop();
      setIsListening(false);
      setStatusMessage('Listening paused.');
    } else {
      recognition.start();
      setIsListening(true);
      setStatusMessage('Listening resumed.');
    }
  };

  const formatTimer = (secs: number) => {
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  };

  const derivedInsights = useMemo(() => insights, [insights]);

  return (
    <div className="w-full flex flex-col space-y-6">
      <div className="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-4">
        <div>
          <div className="flex items-center space-x-3 mb-2">
            <div className="relative flex h-2.5 w-2.5">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#f751a1] opacity-75"></span>
              <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#f751a1]"></span>
            </div>
            <span className="text-[#ffb0cd] font-mono text-[11px] uppercase tracking-widest font-bold">
              Live AI Processing
            </span>
          </div>
          <h1 className="text-3xl font-extrabold font-display tracking-tight text-white">Live Meeting Copilot</h1>
          <p className="text-sm text-zinc-400 mt-2">Create, join, and run a live AI meeting with transcript capture, decisions, tasks, risks, and memory.</p>
        </div>

        <div className="flex flex-wrap items-center gap-3 text-xs font-semibold">
          <button
            onClick={() => setIsPlaying(!isPlaying)}
            className="flex items-center bg-zinc-900/50 border border-zinc-800 hover:border-violet-500/30 text-zinc-200 px-3.5 py-2 rounded-full transition"
          >
            {isPlaying ? (
              <>
                <Pause className="w-3.5 h-3.5 mr-1.5 text-fuchsia-400" /> Pause Stream
              </>
            ) : (
              <>
                <Play className="w-3.5 h-3.5 mr-1.5 text-emerald-400" /> Resume Stream
              </>
            )}
          </button>
          <button
            onClick={handleToggleListening}
            className="flex items-center bg-zinc-900/50 border border-zinc-800 hover:border-violet-500/30 text-zinc-200 px-3.5 py-2 rounded-full transition"
          >
            {isListening ? <MicOff className="w-3.5 h-3.5 mr-1.5 text-amber-400" /> : <Mic className="w-3.5 h-3.5 mr-1.5 text-emerald-400" />}
            {isListening ? 'Stop Listening' : 'Start Listening'}
          </button>
          <button
            onClick={handleReset}
            className="flex items-center bg-zinc-900/50 border border-zinc-800 hover:border-violet-500/30 text-zinc-200 px-3.5 py-2 rounded-full transition"
          >
            <RotateCcw className="w-3.5 h-3.5 mr-1.5" /> Reset
          </button>

          <span className="flex items-center bg-zinc-900 border border-zinc-800 px-3.5 py-2 rounded-full text-zinc-400">
            <Clock className="w-3.5 h-3.5 mr-1.5 text-violet-400" /> {formatTimer(timer)}
          </span>
          <span className="flex items-center bg-zinc-900 border border-zinc-800 px-3.5 py-2 rounded-full text-zinc-400">
            <Users className="w-3.5 h-3.5 mr-1.5 text-fuchsia-400" /> {entries.length} utterances
          </span>
        </div>
      </div>

      <div className="grid grid-cols-12 gap-6 h-[calc(100vh-230px)] min-h-[500px]">
        <div className="col-span-12 lg:col-span-8 bg-[#12172A] rounded-xl border border-[#232B45] flex flex-col relative overflow-hidden shadow-2xl">
          <div className="bg-[#0a0e17]/80 backdrop-blur-md px-6 py-4 flex items-center justify-between border-b border-[#232B45] z-10 w-full">
            <h3 className="font-bold font-display text-[16px] text-[#6366F1] flex items-center gap-2">
              <MessageSquare className="w-4 h-4" /> Streaming Transcript
            </h3>
            <div className="flex items-center space-x-2">
              <span className={`h-1.5 w-1.5 rounded-full shadow-[0_0_8px_#6366F1] ${isListening ? 'bg-[#6366F1] animate-pulse' : 'bg-zinc-650'}`}></span>
              <span className="text-[#94A3B8] text-xs font-semibold uppercase tracking-wider">{isListening ? 'Active Listening' : 'Paused'}</span>
            </div>
          </div>

          <div className="px-6 py-4 border-b border-[#232B45] bg-[#0b1020] flex flex-wrap gap-3 items-center">
            <input
              value={title}
              onChange={(event) => setTitle(event.target.value)}
              className="rounded-full border border-[#232B45] bg-[#12172A] px-3 py-2 text-sm text-zinc-200 w-44"
              placeholder="Meeting title"
            />
            <input
              value={hostName}
              onChange={(event) => setHostName(event.target.value)}
              className="rounded-full border border-[#232B45] bg-[#12172A] px-3 py-2 text-sm text-zinc-200 w-36"
              placeholder="Your name"
            />
            <button onClick={createMeeting} disabled={isCreating} className="flex items-center rounded-full bg-[#6366F1] px-3 py-2 text-sm font-semibold text-white disabled:opacity-60">
              <Plus className="mr-1.5 h-4 w-4" /> {isCreating ? 'Creating…' : 'Create Meeting'}
            </button>
            <button onClick={startMeeting} disabled={!meetingId || meetingStatus === 'live'} className="flex items-center rounded-full border border-[#232B45] bg-[#12172A] px-3 py-2 text-sm text-zinc-200 disabled:opacity-60">
              <Play className="mr-1.5 h-4 w-4 text-emerald-400" /> Start
            </button>
            <button onClick={endMeeting} disabled={!meetingId || meetingStatus === 'ended'} className="flex items-center rounded-full border border-[#232B45] bg-[#12172A] px-3 py-2 text-sm text-zinc-200 disabled:opacity-60">
              <Pause className="mr-1.5 h-4 w-4 text-amber-400" /> End
            </button>
            <div className="ml-auto flex items-center gap-2 rounded-full border border-[#232B45] bg-[#12172A] px-3 py-2 text-xs text-zinc-400">
              <Link2 className="h-3.5 w-3.5 text-fuchsia-400" />
              <span>{joinLink}</span>
            </div>
          </div>

          <div className="flex-1 p-6 overflow-y-auto flex flex-col justify-start space-y-4 scrollbar-thin">
            <div className="rounded-lg border border-[#232B45] bg-[#0a0e17] px-4 py-3 text-sm text-[#94A3B8]">
              {statusMessage}
            </div>

            {entries.length === 0 ? (
              <div className="rounded-xl border border-dashed border-[#232B45] p-6 text-sm text-[#94A3B8] italic">
                No transcript yet. Click “Start Listening” and speak naturally. The assistant will detect commitments, decisions, and risks live.
              </div>
            ) : (
              entries.map((entry) => (
                <div key={entry.id} className="flex items-start space-x-4 max-w-2xl">
                  <div className="flex-shrink-0 w-10 h-10 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 font-bold text-sm">
                    {entry.speaker.slice(0, 2).toUpperCase()}
                  </div>
                  <div className="space-y-1">
                    <div className="flex items-baseline space-x-2">
                      <span className="font-bold text-sm text-[#dfe2ef]">{entry.speaker}</span>
                      <span className="text-[10px] text-[#94A3B8]">{entry.timestamp}</span>
                    </div>
                    <p className="text-sm text-[#dfe2ef] bg-[#0a0e17] px-4 py-3 rounded-2xl rounded-tl-sm border border-[#232B45] leading-relaxed">
                      {entry.text}
                    </p>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        <div className="col-span-12 lg:col-span-4 flex flex-col space-y-6">
          <div className="bg-[#12172A] rounded-xl border border-[#232B45] shadow-xl">
            <div className="p-4 border-b border-[#232B45] flex items-center justify-between">
              <h4 className="font-bold font-display text-sm text-[#dfe2ef] flex items-center gap-2">
                <Sparkles className="w-4.5 h-4.5 text-fuchsia-400" /> AI Memory
              </h4>
              <span className="text-[9px] uppercase tracking-wider text-zinc-500">{meetingStatus}</span>
            </div>
            <div className="p-4 space-y-3">
              <div className="rounded-lg border border-[#232B45] bg-[#0a0e17] p-3 text-xs text-[#94A3B8]">
                <p className="font-semibold text-[#dfe2ef] mb-1">Meeting context</p>
                <p>{title} hosted by {hostName}</p>
                <p className="mt-1">Participants: {participants.join(', ')}</p>
              </div>
              <div className="space-y-2">
                {memory.length > 0 ? memory.map((item, index) => (
                  <div key={`${item}-${index}`} className="rounded-lg border border-[#232B45] bg-[#0a0e17] p-2.5 text-xs text-[#94A3B8]">
                    {item}
                  </div>
                )) : <p className="text-xs text-[#94A3B8] italic">Memory notes will appear here as the meeting progresses.</p>}
              </div>
              <div className="flex gap-2">
                <input
                  value={draftNote}
                  onChange={(event) => setDraftNote(event.target.value)}
                  className="flex-1 rounded-full border border-[#232B45] bg-[#0a0e17] px-3 py-2 text-xs text-zinc-200"
                  placeholder="Save a memory note"
                />
                <button onClick={handleAddMemory} className="rounded-full bg-[#6366F1] p-2 text-white">
                  <Send className="h-3.5 w-3.5" />
                </button>
              </div>
            </div>
          </div>

          <div className="bg-[#12172A] rounded-xl border border-[#232B45] shadow-xl">
            <div className="p-4 border-b border-[#232B45] flex items-center justify-between">
              <h4 className="font-bold font-display text-sm text-[#dfe2ef] flex items-center gap-2">
                <MessageSquare className="w-4.5 h-4.5 text-blue-400" /> AI Activity
              </h4>
            </div>
            <div className="p-4 space-y-2 max-h-48 overflow-y-auto">
              {activity.length > 0 ? activity.map((item) => (
                <div key={item.id} className="rounded-lg border border-[#232B45] bg-[#0a0e17] p-2.5 text-xs text-[#94A3B8]">
                  <p>{item.text}</p>
                  <p className="mt-1 text-[10px] uppercase tracking-wider text-zinc-500">{item.timestamp}</p>
                </div>
              )) : <p className="text-xs text-[#94A3B8] italic">AI status updates appear here.</p>}
            </div>
          </div>

          <div className="flex-1 flex flex-col bg-[#12172A] rounded-xl border border-[#232B45] shadow-xl relative overflow-hidden">
            <div className="p-4 border-b border-[#232B45] flex items-center justify-between">
              <h4 className="font-bold font-display text-sm text-[#dfe2ef] flex items-center gap-2">
                <CheckCircle2 className="w-4.5 h-4.5 text-emerald-400" />
                Decisions Detected
              </h4>
              <span className="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[9px] px-2 py-0.5 rounded font-mono font-bold uppercase tracking-wider">
                {derivedInsights.decisions.length} Found
              </span>
            </div>

            <div className="p-4 flex-1 overflow-y-auto space-y-3">
              {derivedInsights.decisions.length > 0 ? derivedInsights.decisions.map((item) => (
                <div key={item.id} className="bg-[#0a0e17] border border-emerald-500/20 rounded-lg p-3.5">
                  <p className="text-xs font-bold text-[#dfe2ef] leading-tight">{item.title}</p>
                  <p className="text-[10px] text-[#94A3B8] mt-1.5">{item.detail}</p>
                </div>
              )) : (
                <p className="text-xs text-[#94A3B8] italic text-center py-6">Listening for team consensus...</p>
              )}
            </div>
          </div>

          <div className="flex-1 flex flex-col bg-[#12172A] rounded-xl border border-[#232B45] shadow-xl">
            <div className="p-4 border-b border-[#232B45] flex items-center justify-between">
              <h4 className="font-bold font-display text-sm text-[#dfe2ef] flex items-center gap-2">
                <ClipboardList className="w-4.5 h-4.5 text-[#6366F1]" />
                Action Items
              </h4>
              <span className="bg-[#6366F1]/15 text-[#6366F1] border border-[#6366F1]/20 text-[9px] px-2 py-0.5 rounded font-mono font-bold uppercase tracking-wider">
                {derivedInsights.actionItems.length} Pending
              </span>
            </div>

            <div className="p-4 flex-1 overflow-y-auto space-y-3">
              {derivedInsights.actionItems.length > 0 ? derivedInsights.actionItems.map((item) => (
                <div key={item.id} className="bg-[#0a0e17] border border-[#232B45] rounded-lg p-3.5">
                  <p className="text-xs font-bold text-[#dfe2ef] leading-tight">{item.title}</p>
                  <p className="text-[10px] text-[#94A3B8] mt-1.5">Assigned to {item.assignee || 'team'}</p>
                </div>
              )) : (
                <p className="text-xs text-[#94A3B8] italic text-center py-6">Listening for commitments...</p>
              )}
            </div>
          </div>

          <div className="flex-1 flex flex-col bg-[#12172A] rounded-xl border border-[#232B45] shadow-xl relative overflow-hidden">
            <div className="p-4 border-b border-[#232B45] flex items-center justify-between">
              <h4 className="font-bold font-display text-sm text-[#dfe2ef] flex items-center gap-2">
                <AlertTriangle className="w-4.5 h-4.5 text-amber-500" />
                Risks Flagged
              </h4>
              <span className="bg-amber-500/15 text-amber-400 border border-amber-500/20 text-[9px] px-2 py-0.5 rounded font-mono font-bold uppercase tracking-wider">
                {derivedInsights.risks.length} Flagged
              </span>
            </div>

            <div className="p-4 flex-1 overflow-y-auto space-y-3">
              {derivedInsights.risks.length > 0 ? derivedInsights.risks.map((item) => (
                <div key={item.id} className="bg-[#0a0e17] border border-amber-500/20 rounded-lg p-3.5">
                  <p className="text-xs font-bold text-[#dfe2ef] leading-tight">{item.title}</p>
                  <p className="text-[10px] text-[#94A3B8] mt-1.5">{item.detail}</p>
                </div>
              )) : (
                <p className="text-xs text-[#94A3B8] italic text-center py-6">Listening for project bottlenecks...</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
