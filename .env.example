# Database Connection (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your-secure-jwt-secret-key"

# AI Extraction API Keys
NVIDIA_API_KEY="nvapi-your-nvidia-nemotron-key"
LLAMA_API_KEY="llx-your-llamacloud-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-key" # Optional fallback

# Speech Recognition & Transcription API Keys (Optional Cloud Fallbacks)
OPENAI_API_KEY="sk-your-openai-api-key"       # Optional cloud Whisper
GROQ_API_KEY="gsk_your_groq_api_key"          # Optional fast Groq Whisper
WHISPER_MODEL="Xenova/whisper-base"           # Local ONNX model name

# WebRTC LiveKit Integration (Optional for Live Video Meetings)
LIVEKIT_URL="wss://your-livekit-project.livekit.cloud"
LIVEKIT_API_KEY="APIyourLiveKitKey"
LIVEKIT_API_SECRET="yourLiveKitSecretKey"

# Application Server Port
PORT=3000
