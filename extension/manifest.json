{
  "manifest_version": 3,
  "name": "Cue Intelligence - AI Meeting Assistant",
  "version": "1.1.0",
  "description": "Floating draggable & resizable real-time audio recorder, transcript stream & meeting intelligence assistant.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cue Intelligence Floating Assistant"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
